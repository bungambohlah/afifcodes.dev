{
  "name": "my-portfolio",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://afifcodes.dev",
  "scripts": {
    "install:clean": "rm -rf node_modules && rm yarn.lock && yarn",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "debug:dev": "NODE_OPTIONS='--inspect' next dev",
    "check-lint": "eslint . --ignore-path .gitignore --ignore-pattern /out --ignore-pattern /.next",
    "check-format": "prettier --list-different --ignore-path .gitignore .",
    "lint": "eslint . --fix --ignore-path .gitignore --ignore-pattern /out --ignore-pattern /.next",
    "format": "prettier --write --list-different --ignore-path .gitignore .",
    "validate": "npm-run-all --parallel lint format",
    "validate:build": "npm-run-all --parallel validate build"
  },
  "dependencies": {
    "@badrap/bar-of-progress": "^0.3.0",
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "classnames": "^2.5.1",
    "framer-motion": "^14.2.0",
    "memory-cache": "^0.2.0",
    "moment": "^2.29.4",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.6.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/memory-cache": "^0.2.6",
    "@types/node": "^22.9.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "process": "^0.11.10",
    "typescript-eslint": "^8.71.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "yarn lint",
    "*.{js,jsx,ts,tsx,css,json,md}": "yarn format"
  }
}
